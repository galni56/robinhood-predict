{
  "name": "robinhood-predict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mock prediction-market demo for tokenized stocks on a fictional chain. All data, prices, accounts and on-chain activity are simulated client-side — there is no real backend, no real blockchain and no real funds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:asset-race-registry": "node scripts/check-asset-race-registry.mjs",
    "check:asset-race-stock-pools": "node scripts/check-asset-race-stock-pools.mjs",
    "check:asset-race-meme-pools": "node scripts/check-asset-race-meme-pools.mjs",
    "keeper:asset-race": "node scripts/asset-race-keeper.mjs",
    "test:asset-race-keeper": "node --test scripts/asset-race-keeper.test.mjs",
    "keeper:prediction-market": "node scripts/prediction-market-keeper.mjs",
    "test:prediction-market-keeper": "node --test scripts/prediction-market-keeper.test.mjs",
    "keeper:price-arena": "node scripts/price-arena-keeper.mjs",
    "test:price-arena-keeper": "node --test scripts/price-arena-keeper.test.mjs",
    "serve:share-preview": "node scripts/share-preview-server.mjs",
    "test:share-preview": "node --test scripts/share-preview-server.test.mjs",
    "config:price-arena": "node scripts/price-arena-deployment-config.mjs",
    "e2e:asset-race-stock": "node scripts/asset-race-stock-e2e.mjs",
    "e2e:asset-race-meme": "node scripts/asset-race-stock-e2e.mjs --meme",
    "test:asset-race-collector": "node --test scripts/asset-race-pool-price-engine.test.mjs scripts/asset-race-pool-endpoints.test.mjs scripts/asset-race-native-eth.test.mjs",
    "live:asset-race": "node scripts/asset-race-live-server.mjs",
    "test:asset-race-live": "node --experimental-strip-types --test scripts/asset-race-live-prices.test.mjs scripts/asset-race-live-display.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
