# Copy to .env, fill in, NEVER commit .env (it's already in .gitignore).
# Never paste a real private key into a chat with Claude or anyone else —
# generate it locally (`cast wallet new`) and only ever put it here.

# Burner wallet only. Testnet funds only, until this has had a security review.
PRIVATE_KEY=0x...

# Public, rate-limited: https://rpc.testnet.chain.robinhood.com
# Or your own Alchemy key: https://robinhood-testnet.g.alchemy.com/v2/<key>
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# ERC20 the market accepts bets in. On testnet, deploy MockERC20 yourself and
# mint test balance to your wallet, or use whatever testnet stablecoin
# Robinhood/Chainlink docs point to at the time.
BET_TOKEN_ADDRESS=0x...

# Set after `forge script script/Deploy.s.sol --broadcast` succeeds.
MARKET_ADDRESS=0x...

# Chainlink feed for the specific stock token you're creating a market for.
# ALWAYS look this up fresh at deploy time:
# https://docs.chain.link/data-feeds/tokenized-equity-feeds/robinhood
PRICE_FEED_ADDRESS=0x...
TARGET_PRICE=10000000000
DEADLINE_UNIX=0
