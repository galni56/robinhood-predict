# Copy to contracts/.env, keep mode 0600, and never commit real secrets.
# Foundry reads this file locally; scripts validate public roles before broadcast.

# One owner/deployer key for all three products.
PRIVATE_KEY=0x...

# Use the project's paid provider locally. The public endpoint is only a fallback.
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Reviewed public roles and shared signed-pool oracle.
EXPECTED_OWNER_ADDRESS=0x6d68157bEDa778346Dd27f8Ef4F917f69aD2Dc41
SIGNED_POOL_ORACLE_ADDRESS=0x5b0f7e62E0A5fF5C5C02Ad219Afcd086F2618Db7
PRICE_SIGNER_ADDRESS=0x79F4991Ccc64Cbb8143fB61e4cBD49b8b64d3635

# PredictionMarket immutable native-ETH fuses and fee.
MAX_SEED_LIQUIDITY_WEI=100000000000000000
MAX_STAKE_PER_SIDE_WEI=100000000000000000
FEE_BP=200

# Fill only after the latest PredictionMarket deployment succeeds.
MARKET_ADDRESS=0x...

# Generate both values from the repository root; do not hand-maintain them:
#   node scripts/check-asset-race-registry.mjs --deployment-symbols
#   node scripts/check-asset-race-registry.mjs --deployment-oracle-ids
ASSET_SYMBOLS=NVDA,TSLA,AAPL,META,MSTR,AMZN,MSFT,GOOGL,MU,NFLX
ASSET_ORACLE_IDS=0x...

# Optional one-market creation inputs. Target uses 18 price decimals and the
# deadline is a Unix timestamp at least 30 minutes in the future.
ASSET_SYMBOL=TSLA
TARGET_PRICE=100000000000000000000
DEADLINE_UNIX=0
SEED_YES_AMOUNT=0
SEED_NO_AMOUNT=0
